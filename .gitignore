# 시크릿
.env
.env.local
.env.*.local

# 코퍼스 원문 — 저작권 (planner §5.2)
# 커밋하는 것은 processed/ 의 정제본과 메타데이터, sha256 해시뿐이다.
corpus/raw/

# 통계 원본 CP949 드롭존 — 재다운로드 가능, sha256으로 검증 (corpus/stats/SOURCES.md)
corpus/stats/_incoming/

# 빌드 산출물 — 인덱스는 Docker 빌드 타임에 생성해 이미지에 동봉한다
data/
apps/api/data/

# 슬림화한 로컬 생성 모델 — 수 GB 다. 원본(HF 캐시)에서 언제든 재생성된다.
#   python apps/api/scripts/export_local_model.py --stage textonly
#   python apps/api/scripts/export_local_model.py --stage int8
models/

# 추출 동일성 검사의 중간 산출물 (로짓·토큰 캡처). 재생성된다.
#   python apps/api/scripts/check_equivalence.py --capture …
apps/api/.cache_equivalence/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Node / Next.js
node_modules/
.next/
out/
.turbo/

# 에디터 · OS
.DS_Store
.idea/
.vscode/
*.swp

# 리포트 그림은 커밋하지 않는다 — 커밋된 리포트 JSON 과 eval/report_charts.py 로
# 언제든 재생성된다. HTML 은 plotly 를 인라인해 4MB 가 넘는다.
#   python eval/report_charts.py --history
eval/reports/charts/
.claude
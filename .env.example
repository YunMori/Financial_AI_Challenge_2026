# K-Buddy 환경변수 예시
# 실제 값을 채운 뒤 .env 로 복사한다. .env 는 절대 커밋하지 않는다.
# 코드 ZIP 제출 시 이 파일만 포함하고 .env 는 제거되었는지 확인할 것 (planner §18.2).

# ── 백엔드 (apps/api) ────────────────────────────────────────────────

# 생성 LLM — Anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
# 장애·거절 시 폴백. 위로 올린다(성공률 > 비용): ADR-002 참조
LLM_MODEL_FALLBACK=claude-opus-5
# 질의 정규화용 소형 모델 (planner §6.2 3단)
LLM_MODEL_SMALL=claude-haiku-4-5
# low | medium | high | xhigh | max — sonnet-5 기본값은 high 이므로 반드시 명시할 것
LLM_EFFORT=medium

# 임베딩 — 로컬 실행. 문서 임베딩은 빌드 타임, 런타임은 쿼리 1건만.
# Phase 7 메모리 실측 결과에 따라 확정 (ADR-003)
EMBED_MODEL=BAAI/bge-m3

# 인덱스 경로 (Docker 이미지에 동봉, 런타임 다운로드 금지 — 콜드스타트 악화)
CHROMA_PATH=./data/chroma
BM25_INDEX_PATH=./data/bm25.pkl

# 외부 OpenAPI — M1 범위 밖이지만 키는 미리 넣어 둔다
FSS_API_KEY=
ECOS_API_KEY=

# 운영
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MIN=20
LOG_LEVEL=INFO

# 주: LLM_REGION 은 두지 않는다.
# Anthropic API 는 해외 리전이므로 planner §15.2 의 국내 리전 원칙은 충족 불가.
# 대신 임베딩·벡터DB·BM25·가드레일·계층 판정이 전부 로컬이고 외부 호출은 생성 하나뿐이다.
# 이 트레이드오프는 docs/adr/ADR-002-llm-selection.md 에 기록한다.

# ── 프론트엔드 (apps/web) ────────────────────────────────────────────

NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
# 서비스 사칭 대응 고지에 표기할 공식 도메인 (planner §11장)
NEXT_PUBLIC_OFFICIAL_DOMAIN=

# K-Buddy 환경변수 예시
# 실제 값을 채운 뒤 .env 로 복사한다. .env 는 절대 커밋하지 않는다.
# 코드 ZIP 제출 시 이 파일만 포함하고 .env 는 제거되었는지 확인할 것 (planner §18.2).
#
# ★ 값이 코드 기본값과 어긋나면 이 파일이 사고를 만든다. 실제로
#   `EMBED_MODEL=BAAI/bge-m3` 가 남아 있었는데 fastembed 가 지원하지 않는
#   모델이라, 이 파일을 그대로 따라 한 사람은 **검색이 조용히 무너진다**
#   (2026-08-21 발견). 코드를 바꾸면 여기도 같이 바꾼다.

# ── 백엔드 (apps/api) ────────────────────────────────────────────────

# ── 생성 백엔드 ─────────────────────────────────────────────────────
#
# local     외부로 나가는 호출이 **하나도 없다**. ADR-004 의 국내 리전 주장이
#           문구가 아니라 실제 동작으로 성립하는 경로이며 **기본값**이다.
# anthropic 아래 ANTHROPIC_API_KEY 가 필요하다.
LLM_BACKEND=local

# LLM_BACKEND=local 일 때 쓰는 모델. HuggingFace 이름 또는 로컬 경로.
# 슬림 산출물을 쓰려면 먼저 만들어야 한다 (없으면 첫 질의에서 죽는다):
#     python apps/api/scripts/export_local_model.py --stage textonly
LOCAL_MODEL=Qwen/Qwen3.5-4B
LOCAL_DEVICE=auto
LOCAL_DTYPE=auto

# 생성 LLM — Anthropic (LLM_BACKEND=anthropic 일 때만 필요)
# 비워 두면 `/healthz` 의 llm_configured 가 false 가 되고 생성이 폴백된다.
# **로컬 백엔드에서는 비어 있는 것이 정상이다.**
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
# 장애·거절 시 폴백. 위로 올린다(성공률 > 비용): ADR-002 참조
LLM_MODEL_FALLBACK=claude-opus-5
# 질의 정규화용 소형 모델 (planner §6.2 3단)
LLM_MODEL_SMALL=claude-haiku-4-5
# low | medium | high | xhigh | max — sonnet-5 기본값은 high 이므로 반드시 명시할 것
LLM_EFFORT=medium

# 임베딩 — 로컬 실행. 문서 임베딩은 빌드 타임, 런타임은 쿼리 1건만.
# ★ **색인기와 런타임이 같은 값을 봐야 한다.** 다르면 벡터 공간이 어긋나
#   에러 없이 검색만 조용히 무너진다. fastembed 는 BGE-m3 를 지원하지 않으므로
#   e5-large 다 (ADR-003 은 컨테이너 메모리 실측 후 확정).
EMBED_MODEL=intfloat/multilingual-e5-large

# 인덱스 경로 (Docker 이미지에 동봉, 런타임 다운로드 금지 — 콜드스타트 악화)
CHROMA_PATH=./data/chroma
BM25_INDEX_PATH=./data/bm25.pkl
# 임베딩 모델 캐시. 같은 이유로 data/ 안에 둔다 — 기본값인 %TEMP% 에 두면
# temp 가 비워질 때 첫 질의가 재다운로드(23초)를 물고, 오프라인에서는 검색이 죽는다.
EMBED_CACHE_PATH=./data/embed_cache

# 외부 OpenAPI (F7 금융상품 · F6 송금 환율)
# 비어 있으면 두 기능이 죽지 않고 available=false / rate=null 로 정직하게 나간다.
# 발급: finlife.fss.or.kr (즉시) · ecos.bok.or.kr (즉시) — planner §0.1 0-1·0-2
FSS_API_KEY=
ECOS_API_KEY=
# 외부가 느릴 때 화면까지 같이 멎지 않게 한다 — 오래 기다리느니 빨리 말한다.
EXTERNAL_API_TIMEOUT_S=5.0

# 운영
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MIN=20
LOG_LEVEL=INFO

# 주: LLM_REGION 은 두지 않는다.
# Anthropic API 는 해외 리전이므로 planner §15.2 의 국내 리전 원칙은 충족 불가.
# 대신 임베딩·벡터DB·BM25·가드레일·계층 판정이 전부 로컬이고 외부 호출은 생성 하나뿐이다.
# LLM_BACKEND=local 이면 그 하나마저 사라진다 (ADR-004).
# 이 트레이드오프는 docs/adr/ADR-002-llm-selection.md 에 기록한다.

# ── 프론트엔드 (apps/web) ────────────────────────────────────────────
#
# ⚠ Next.js 는 리포 루트의 .env 를 읽지 않는다. 값을 바꾸려면
#   `apps/web/.env.local` 에 둔다. 기본값으로 충분하면 만들지 않아도 된다.
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
# 서비스 사칭 대응 고지에 표기할 공식 도메인 (planner §11장)
NEXT_PUBLIC_OFFICIAL_DOMAIN=
